# ==========================================
# SHOPSTACK PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE (Neon / Supabase PostgreSQL)
DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/shopstack?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here

# 2. JWT SECURITY
JWT_SECRET_KEY=a_super_secret_256_bit_random_key_string_for_production_security
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# 3. CORS & FRONTEND
CORS_ALLOWED_ORIGINS=https://shopstack.vercel.app

# 4. ADMIN SEEDER ACCOUNT
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=StrongAdminPassword123!

# 5. OAUTH & PAYMENTS (OPTIONAL / INTEGRATION)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
